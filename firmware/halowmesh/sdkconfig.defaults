# HalowChat mesh: target-independent defaults. Board pins are in sdkconfig.defaults.esp32s3.

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# esp-halow's mmosal_task_sleep() needs a 1000 Hz tick (see the Ottercam bridge README).
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_PRIORITY=10

CONFIG_HALOW_COUNTRY_CODE="US"
# CONFIG_HALOW_PS_MODE is not set

# The mesh interface is brought up through morselib's access-point code.
CONFIG_HALOW_AP_MODE=y
CONFIG_MBEDTLS_NIST_KW_C=y
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y

CONFIG_LWIP_L2_TO_L3_COPY=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_LWIP_IRAM_OPTIMIZATION=y

# Message store lives in the XIAO ESP32S3's 8 MB octal PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y

# Bigger TCP windows: photos between boards went from about 500 to about 900 kbit/s on a
# 2 MHz channel with these, against ESP-IDF's 5.7 KB default.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
