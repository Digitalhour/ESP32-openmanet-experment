# batman-probe: a batman-adv (BATMAN_V) node on the XIAO ESP32S3 over its 2.4 GHz Wi-Fi,
# to be tested against a Linux batman-adv peer on the same LAN. No HaLow in this build.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768

# IP reassembly, so packets bigger than the MTU (large pings, big UDP) arrive whole.
CONFIG_LWIP_IP4_REASSEMBLY=y
CONFIG_LWIP_IP_REASS_MAX_PBUFS=20
