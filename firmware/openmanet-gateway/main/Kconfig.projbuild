menu "OpenMANET XIAO Gateway: mesh role"

    config GW_DEFAULT_ROLE_MESH
        bool "Factory-fresh nodes start in the mesh role"
        default y
        help
            With this on, a node that has never been configured comes up as a mesh
            node: phone hotspot plus the HaLow mesh. Off keeps the original default,
            the client role (HaLow station to an access point).

    config GW_MESH_ID
        string "Mesh name (802.11s Mesh ID)"
        default "OpenMANET-XIAO"
        help
            Boards with the same mesh name on the same channel find each other from
            their beacons and relay for each other.

    config GW_MESH_S1G_CHANNEL
        int "HaLow channel (S1G channel number)"
        range 1 51
        default 26
        help
            26 = 915 MHz, 2 MHz wide (US). US channels sit at 902 + 0.5 x N MHz.

    config GW_MESH_S1G_OPCLASS
        int "HaLow operating class"
        range 68 71
        default 69
        help
            68 = 1 MHz, 69 = 2 MHz, 70 = 4 MHz, 71 = 8 MHz.

    config GW_MESH_TX_DBM
        int "Cap HaLow TX power (dBm, 0 = regulatory maximum)"
        range 0 30
        default 8
        help
            Keep it low on the desk: boards a few feet apart overload each other,
            and weak USB ports cannot feed full power. Set 0 for the field.

    config GW_MESH_TTL
        int "Hop limit for relayed frames"
        range 1 31
        default 8

    config GW_MESH_SPI_MAX_HZ
        int "Cap the HaLow SPI clock (Hz)"
        range 1000000 50000000
        default 40000000

    config GW_MESH_RESET_HOLD_MS
        int "Hold the HaLow chip in reset this long (ms)"
        range 5 20000
        default 8000

    config GW_MESH_RESET_SETTLE_MS
        int "HaLow chip boot time after reset (ms)"
        range 20 2000
        default 250

endmenu
