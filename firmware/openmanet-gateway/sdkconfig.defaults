# Target is set via `idf.py set-target esp32s3` (not pinned here so this file
# stays portable if a C5 build is added later per DESIGN.md §3).

# --- lwIP: required for XIAO-side IP forwarding + NAT between the HaLow
# uplink netif and the local SoftAP netif (DESIGN.md §4.2/§4.3). ---
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# (No CONFIG_LWIP_IGMP option exists in this IDF version - it's hardcoded on
# unconditionally in lwipopts.h, confirmed by a real build; nothing to set.)

# The CoT relay uses IP_PKTINFO/recvmsg() on a single dual-joined socket to
# determine which netif each multicast datagram actually arrived on, so it
# can be forwarded out the other one without risking a loop.
CONFIG_LWIP_NETBUF_RECVINFO=y

# Explicit lwIP socket budget (review finding F13,
# design/PROJECT_REVIEW_2026-09-10.md: "socket budgets conflict with maximum
# HTTP concurrency" - this project was relying on the Kconfig default of 10
# happening to be enough, undocumented and, for GW_ROLE_RELAY, exactly at the
# edge with zero margin). Every subsystem that opens a socket, counted
# against the real ESP-IDF/this-project source, not assumed:
#
#   - Web UI (esp_https_server, since the 2026-09-10 HTTPS switch - review
#     finding F02): HTTPD_SSL_CONFIG_DEFAULT() sets max_open_sockets=4
#     (esp_https_server.h), and esp_http_server.h's own max_open_sockets doc
#     comment states "3 sockets are reserved for internal working of the HTTP
#     server" - so this alone is 4 + 3 = 7 sockets, always, both roles.
#   - CoT relay (main/cot_relay.c): 1 - a single socket joined to the group
#     on both netifs (s_sock), both roles.
#   - DNS forwarder (main/dns_forward.c): 2 - s_listen_sock (leaves query
#     this) + s_upstream_sock (talks to the real resolver). GW_ROLE_RELAY
#     only.
#
# GW_ROLE_CLIENT needs 7 + 1 = 8. GW_ROLE_RELAY needs 7 + 1 + 2 = 10 -
# exactly CONFIG_LWIP_MAX_SOCKETS' Kconfig default, meaning a relay boots
# with *zero* spare sockets for anything else lwIP might transiently need
# (e.g. a browser tab's TCP connection lingering in TIME_WAIT after close).
# +4 margin over the relay's own 10-socket requirement, not a round number -
# `struct netconn` is a real, non-trivial struct and
# MEMP_NUM_NETCONN == CONFIG_LWIP_MAX_SOCKETS (components/lwip/port/include/
# lwipopts.h) preallocates one per socket slot regardless of whether it's
# ever opened. Measured on real hardware (a GW_ROLE_RELAY node, idle, uplink
# associated, one HaLow leaf attached), not guessed: free internal heap went
# from 103,279 bytes at 10 to 101,579 bytes at 14 - 1,700 bytes for 4 extra
# slots, ~425 bytes/socket. Cheap for going from zero spare sockets to four.
CONFIG_LWIP_MAX_SOCKETS=14

# The native 2.4GHz radio runs in exactly one mode per node, never both:
# GW_ROLE_CLIENT (default) uses it AP-only for the local SoftAP
# (downlink_softap.c), while HaLow carries that role's uplink on the separate
# SPI radio (uplink_halow.c). GW_ROLE_RELAY instead uses the native radio
# STA-only, as its own uplink to the Pi's local AP (uplink_wifi.c), while
# HaLow runs AP mode as that role's downlink (see CONFIG_HALOW_AP_MODE
# below) - see design/ROADMAP.md item 8. Neither role needs concurrent
# AP+STA on the native radio, so plain SoftAP support is sufficient here.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# Real HaLow AP-mode support (genuine wpa_supplicant/hostapd code, not a
# stub - confirmed by reading esp-halow's own
# halow/components/hostap/CMakeLists.txt), needed by downlink_halow_ap.c for
# GW_ROLE_RELAY. Off by default in the component's own Kconfig because it
# "increas[es] the flash and ram requirements by a non inconsequential
# amount" (halow/Kconfig) - built into every image here anyway, since role is
# a runtime choice (gwcfg-set-role) and both roles share one firmware binary;
# a GW_ROLE_CLIENT node simply never calls the AP-mode code this pulls in.
# Marked "ALPHA NOTICE" in the SDK's own mmwlan.h and untested by this
# project on real S3+MM6108 hardware - see design/ROADMAP.md item 8 and
# design/PI_SIDE.md "GW_ROLE_RELAY" before trusting it blind on a deployed
# node.
CONFIG_HALOW_AP_MODE=y

# esp_console is used by provisioning.c for the runtime config CLI. The XIAO
# ESP32-S3's USB-C port is wired to the chip's native USB Serial/JTAG
# controller, not an external UART bridge - CONFIG_ESP_CONSOLE_UART_DEFAULT
# would leave both logs and the console silent over that same cable.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- morsemicro/halow: Seeed XIAO ESP32S3 + Seeed XIAO WM6108 pin/chip/BCF
# config, copied from the component's own
# managed_components/morsemicro__halow/configs/sdkconfig.defaults.seeed_xiao_esp32s3-seeed_xiao_mm6108
# (verified against a real `idf.py build` - the component's CMake refuses to
# build at all without these). If the actual board/HAT pairing differs,
# regenerate from the matching file in that configs/ directory instead of
# hand-editing pin numbers. ---
CONFIG_MM_RESET_N=1
CONFIG_MM_WAKE=2
CONFIG_MM_BUSY=5
CONFIG_MM_SPI_SCK=7
CONFIG_MM_SPI_MOSI=9
CONFIG_MM_SPI_MISO=8
CONFIG_MM_SPI_CS=4
CONFIG_MM_SPI_IRQ=3
CONFIG_MM_BCF_FILE="bcf_fgh100mhaamd.bin"
CONFIG_MM_CHIP_MM6108=y

# Power-save OFF, because this HAT does not wire the two pins it needs.
#
# This is NOT in the vendor's board file and is NOT cleanup - do not drop it.
# The component's own Kconfig (halow/Kconfig L20-27) declares:
#
#     config HALOW_PS_MODE
#         bool "Enable Morse Micro HaLow Powersave Mode"
#         default true
#         depends on MM_WAKE >= 0
#         depends on MM_BUSY >= 0
#         help
#             This can only be set to true for devices which have the BUSY and
#             WAKE pins connected.
#
# Both dependencies are satisfied by the CONFIG_MM_WAKE=2 / CONFIG_MM_BUSY=5
# above, so without this line the symbol takes its `default true` and
# power-save runs. But on the Seeed HAT (WI-FI_HALOW_FGH100M_EXT01 rev V3.0)
# those two links are the board's only DNP resistors - R10 (D1->WAKEUP_IN) and
# R17 (D4->BUSY) are unpopulated, with WAKEUP_IN pulled high through R9 and
# BUSY pulled to GND through R15 (see design/HARDWARE.md). The precondition in
# that help text is therefore not met: the driver drives and samples pins that
# reach nothing.
#
# What that costs at runtime, reading the driver:
#   - morse_ps_sleep() (morselib src/driver/morse_driver/ps.c) deasserts WAKE
#     and calls morse_trns_set_irq_enabled(false). The module ignores the WAKE
#     line - R9 holds WAKEUP_IN high, so it never actually sleeps - and keeps
#     running while the host has stopped servicing its SPI interrupt.
#   - morse_ps_wakeup() -> morse_ps_wait_after_wake_pin_raise() then blocks on
#     a semaphore given only by the BUSY edge ISR, which cannot fire on a pin
#     tied to GND, so every wake burns the full chip wakeup delay.
#
# Bus errors accumulated that way reach comms_op_check() (transport/sdio.c
# L120-137) -> mmdrv_host_health_check_required() -> a failed health check ->
# mmdrv_host_hw_restart_required(), whose handler ends in
# MMOSAL_ASSERT(mmdrv_init(...) == MMWLAN_SUCCESS) (umac/umac_mmdrv_shim.c
# L89). A failed assert is not a returned error here: mmosal_impl_assert()
# calls mmhal_reset() -> esp_restart() (shims/mmhal_os.c L45-51), so the whole
# node reboots. Symptom is a boot loop that starts a second or two after
# "Attempting to connect to: <ssid>" and never reaches the connect timeout.
#
# With this off, the shim compiles out the WAKE/BUSY GPIO setup and the BUSY
# ISR entirely (shims/mmhal_wlan.c L43-73, L288-326) and mmhalow_init() calls
# mmwlan_set_power_save_mode(MMWLAN_PS_DISABLED) (mmhalow.c L199-201).
# The cost is real - no radio power save, which matters for a battery build -
# and the fix if that becomes the binding constraint is populating R10/R17 on
# the HAT, not flipping this back.
#
# Upstream does offer a second way out. shims/CMakeLists.txt L36-44 rejects a
# build that sets exactly one of the two pins, with: "MM_WAKE and MM_BUSY pins
# need to either both be defined and routed for power saving, or both need to
# be disabled (-1 defaut definition) to mark this as intentional and forgoe
# power saving" [sic]. So CONFIG_MM_WAKE=-1 + CONFIG_MM_BUSY=-1 would also
# work, and would make power-save structurally unselectable rather than merely
# off. It is deliberately not what's done here: it edits the pin numbers copied
# verbatim from upstream's board config, which is the one part of this file
# design/HARDWARE.md tells you never to hand-edit, and it would imply D1/D4 are
# free pads when a later HAT revision could populate R10/R17. Disabling the
# feature while leaving the pin map alone keeps both documents honest.
CONFIG_HALOW_PS_MODE=n

# HaLow needs a regulatory/country code to know its legal channel list
# (DESIGN.md §6.5). This is a *build-time* setting - unlike uplink
# SSID/security it cannot be changed later via gwcfg-* at runtime, because
# mmhalow_init() reads it directly from Kconfig.
#
# "US" is not a fallback or a placeholder here - it is the only value this
# hardware supports, and this line is now the single source of truth for it
# (CI builds it unmodified; there is no country-configs/ layering any more).
#
# The module is a Quectel FGH100M-H, a 902-928 MHz part. The BCF pinned above,
# CONFIG_MM_BCF_FILE="bcf_fgh100mhaamd.bin", is named "FGH100M-H (US)" in Morse
# Micro's own morse-firmware/WHENCE.md (L53) - and that BCF carries a real
# per-regdom calibration payload for US only. Setting a different code here does
# not fail the build; it produces firmware whose radio never associates. See
# design/HARDWARE.md "Regulatory domain" for the section-by-section evidence.
#
# Still a *build-time* setting - unlike uplink SSID/security it cannot be
# changed later via gwcfg-* at runtime, because mmhalow_init() reads it directly
# from Kconfig (halow/mmhalow.c L191).
CONFIG_HALOW_COUNTRY_CODE="US"

# --- PSRAM: this board's ESP32-S3 module carries 8MB octal PSRAM on-module
# (design/HARDWARE.md's BOM: "flash, octal PSRAM, USB" committed on-module) -
# but CONFIG_SPIRAM defaults to "n" (components/esp_psram/esp32s3/Kconfig.spiram
# L1-3 at v5.5.1), so every byte this firmware has used until now came from the
# ESP32-S3's ~512KB of internal SRAM alone, with lwIP's shared pbuf pool
# (main/cot_relay.h's cot_relay_counters_t comment) drawing from that same
# heap as everything else - SoftAP, the web UI, NAT, HaLow.
#
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y (components/esp_psram/Kconfig.spiram.common
# L101-106) is the specific knob that lets WiFi/lwIP allocations spill into
# PSRAM - it defaults to "n" even with CONFIG_SPIRAM=y alone, so turning on
# PSRAM support by itself would not touch this problem. Paired with
# CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL's own default (16384 bytes, same file
# L88-97, left unset here): allocations under 16KB - which covers every pbuf
# and socket buffer this firmware ever allocates, all comfortably under the
# CoT relay's 1500-byte rx_buffer - still *prefer* fast internal SRAM first,
# and only spill into the 8MB PSRAM pool once internal SRAM is exhausted
# ("If allocation from the preferred region fails, an attempt is made to
# allocate from the non-preferred region instead, so malloc() will not
# suddenly fail when either internal or external memory is full" - same doc
# comment). That's the "fast reserved pool with overflow capacity" behavior
# old router buffer pools hand-implement, for free from ESP-IDF's allocator.
#
# Octal mode (CONFIG_SPIRAM_MODE_OCT) because the on-module part is Octal
# PSRAM, not Quad. 80MHz clock (CONFIG_SPIRAM_SPEED_80M) rather than the
# 40MHz default: 80MHz is the documented ceiling for Octal mode without
# opting into experimental 120MHz support - not worth that risk on a
# stability-first build.
#
# Hardware re-validation note, same as -Os below: PSRAM initialization
# happens very early in boot and a failure there looks identical to other
# early-boot faults - re-confirm checklist steps 1 and 4 on real hardware
# before trusting this.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# --- Partition table: the default single-app table only allows a 1MB app
# partition, but this firmware (HaLow SDK + softAP + NAT + CoT relay +
# console + web UI) doesn't fit - a real `idf.py build` failed with "app
# partition is too small ... overflow 0x93970" (~600KB over) against the
# default, and still didn't fit the built-in "large" preset (1500K). Custom
# 3MB app partition, confirmed real flash size is 8MB (this board's actual
# spec, not a conservative guess) so there's plenty of margin for growth
# (self-beacon, bigger web UI, etc.) without revisiting this again soon. ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# --- Core dumps to flash (partitions.csv has a 64K coredump partition).
# Hardware bring-up means crashes will happen while nobody is attached to the
# console; without this a panic leaves nothing behind but a lost session. With
# it, `idf.py coredump-info` reconstructs the backtrace and task states after
# the fact. ELF format because it carries task/stack detail the raw binary
# format doesn't. ---
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# --- Build-size / throughput knobs ---

# -Os instead of ESP-IDF's default -Og.
#
# The default is COMPILER_OPTIMIZATION_DEBUG (esp-idf/Kconfig at v5.5.1,
# `choice COMPILER_OPTIMIZATION` -> `default COMPILER_OPTIMIZATION_DEBUG`),
# which is -Og. IDF's own help text for the Size setting reads: "The 'Size'
# setting cause the compiled code to be smaller and faster" - both axes, not a
# trade between them.
#
# It matters here more than in a typical app because most of this image isn't
# this project's code: CONFIG_HALOW_AP_MODE=y pulls in esp-halow's vendored
# wpa_supplicant/hostapd fork, and all of it was being built at -Og. The 3 MB
# slot has room today, but the two things queued behind it - OTA (which needs
# a second slot's worth of headroom in practice) and the self-beacon's CoT
# formatter - both spend it.
#
# The cost, and it is real: -Os inlines and reorders enough that a core dump's
# backtrace correlates less cleanly to source lines. Core dumps are on
# precisely because this node crashes unattended (see the coredump section
# above), so that is not a free trade. It is taken deliberately rather than
# silently - `idf.py coredump-info` still symbolizes, it is just less exact
# about which line inside a function.
#
# Hardware re-validation note: this changes codegen for every task in the
# firmware, including the morselib shims that talk to the MM6108 over SPI.
# Checklist steps 1 and 4 passed on real hardware at -Og; re-confirm them after
# the first flash of an -Os build before reading any new failure as a
# regression in something else.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# NAT port forwarding off.
#
# CONFIG_LWIP_IPV4_NAPT_PORTMAP defaults to `y` (components/lwip/Kconfig at
# v5.5.1) and is pulled in implicitly by the CONFIG_LWIP_IPV4_NAPT=y above, so
# this build has been carrying lwIP's port-mapping tables without ever calling
# ip_portmap_add(). It is the machinery for forwarding an inbound port to a
# specific client behind the NAT - which design/ROADMAP.md's "Settled
# decisions" explicitly rules out ("nobody on the mesh can originate a
# connection to a specific phone behind the XIAO"; the v2 fix named there is a
# static route on the Pi, not a firmware change).
#
# Turning it off frees the tables rather than changing any behaviour this
# firmware has. If inbound port forwarding is ever wanted, this line is the
# first thing to flip back - and it should be re-added deliberately, with the
# roadmap decision revisited, rather than left on by default in case.
CONFIG_LWIP_IPV4_NAPT_PORTMAP=n

# The default event loop task ("sys_evt" in gwcfg-tasks/GET /api/tasks) runs
# every esp_event handler this firmware registers on the default loop
# (uplink_wifi.c's WIFI_EVENT/IP_EVENT handler, uplink_halow.c's IP_EVENT
# handler) plus whatever ESP-IDF's own Wi-Fi/netif internals post there - on
# a stack this project has never sized itself, just inherited the Kconfig
# default of 2304 (esp_system/Kconfig L219-221 at v5.5.1) plus the 512-byte
# TASK_EXTRA_STACK_SIZE that CONFIG_NEWLIB_NANO_FORMAT=n (this project's own
# choice, for integer-only frequency formatting - see main/board.h and
# design/ROADMAP.md) adds to every task, for 2816 bytes total.
#
# One real overflow on this exact task already happened here (item 8,
# design/ROADMAP.md) from a deep call chain that has since been moved off
# it entirely (app_main.c's datapath_task()). Measured on real hardware after
# that fix, on both a GW_ROLE_CLIENT and a GW_ROLE_RELAY node through a
# reconnect cycle each (2026-08-30): 2816 - 472 = 2344 bytes used at its
# worst, which is inside this project's own "tight, raise it" band
# (main/provisioning.c's cmd_gwcfg_tasks: <512 B free) and one dropped
# connection away from the <256 B "CRITICAL" band - not overflowing today,
# but with far less margin than every other task in this firmware carries,
# on a task shared with ESP-IDF's own internal event consumers, whose stack
# needs can grow with any component update this project doesn't control.
#
# 4096 matches this project's other worker tasks (wifi_reconnect, datapath,
# console_repl, factory_reset), leaving roughly 1750 bytes (49%) free at the
# measured worst case - comfortably clear of both bands with real headroom
# for whatever ESP-IDF itself needs there in the future.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# --- HTTPS for the web UI/config API (review finding F02,
# design/PROJECT_REVIEW_2026-09-10.md - overturns the "TLS: No" settled
# decision this file used to carry; see design/ROADMAP.md "Settled decisions"
# for the full reasoning change). ---

# esp_https_server's own top-level enable flag - gates its Kconfig submenu and
# depends on (ESP_TLS_USING_MBEDTLS && MBEDTLS_TLS_SERVER)
# (esp_https_server/Kconfig L3-7 at v5.5.1); MBEDTLS_TLS_SERVER was already =y
# in this project's sdkconfig before this line existed (an ESP-IDF default,
# not something turned on for this).
CONFIG_ESP_HTTPS_SERVER_ENABLE=y

# Routes mbedtls's dynamic allocations (TLS session buffers, X.509 parse/write
# scratch, handshake big-number work) into the 8MB PSRAM pool enabled above,
# instead of the ~512KB internal SRAM this project has been guarding closely
# (heap_guard.c's GW_HEAP_*_SHED_BYTES thresholds sit in the tens of KB).
# esp_https_server.h's own HTTPD_SSL_CONFIG_DEFAULT() comment says "one socket
# uses ~40kB RAM with SSL" - that alone would eat roughly a third of this
# board's measured ~109-130KB free internal SRAM (design/ROADMAP.md,
# 2026-08-30) per open HTTPS connection if left on internal SRAM.
#
# Dependency (mbedtls/Kconfig's MBEDTLS_MEM_ALLOC_MODE choice,
# MBEDTLS_EXTERNAL_MEM_ALLOC entry): SPIRAM_USE_CAPS_ALLOC ||
# SPIRAM_USE_MALLOC - already satisfied by CONFIG_SPIRAM_USE_MALLOC=y above.
#
# Tradeoff, recorded rather than hidden: mbedtls's own Kconfig help text notes
# internal SRAM is "most preferred from security perspective" unless flash
# encryption is on (which the same text says also encrypts PSRAM contents on
# S2/S3). This board doesn't have flash encryption yet (review finding F14,
# staged for Stage E - design/PROJECT_REVIEW_2026-09-10.md), so TLS session
# material and the device's own private key sit in cleartext PSRAM while in
# use. That's the same accepted risk profile the admin credential and radio
# passphrases already have sitting in cleartext NVS at rest - not a new gap,
# and worth revisiting together with F14 rather than in isolation.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
