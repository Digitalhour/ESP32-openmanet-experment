build/
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old
# PlatformIO writes a per-environment copy (sdkconfig.<envname>) alongside the
# plain "sdkconfig" idf.py writes - board_build.sdkconfig_defaults keeps both
# seeded from the same sdkconfig.defaults, which stays committed.
sdkconfig.*
!sdkconfig.defaults
.pio/

# Generated by .github/workflows/build-firmware.yml, not committed - see
# docs/index.html for the hand-written source. The workflow assembles the
# single US build alongside it (manifest.json + the .bin set) at the site root.
docs/manifest.json
docs/*.bin

# ccache directory used by the CI build. It lives inside the workspace rather
# than $HOME because esp-idf-ci-action only mounts $GITHUB_WORKSPACE into the
# container - see .github/workflows/build-firmware.yml.
.ccache/

# Left behind by running main/minify_web_ui.py directly.
__pycache__/
